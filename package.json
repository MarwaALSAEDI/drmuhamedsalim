{
  "name": "drmuhamedsalim-clinic",
  "version": "1.0.0",
  "description": "Muhamed Salim Urology Clinic website + admin dashboard (Tailwind CSS v4, zero runtime deps)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "css": "tailwindcss -i src/tailwind.css -o public/tailwind.css --minify",
    "css:watch": "tailwindcss -i src/tailwind.css -o public/tailwind.css --watch",
    "dev": "npm run css && node server.js",
    "font": "node tools/font.js",
    "build": "npm run css && node tools/build-static.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
